# ---- Pipeline (Python) ----
ANTHROPIC_API_KEY=
# Extraction model; use the Batch API for backfills (see pipeline/milmap/extract/llm.py)
MILMAP_EXTRACT_MODEL=claude-sonnet-5-5
# Telegram (my.telegram.org -> API development tools). User-account session, public channels only.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=data/milmap.session
# Contact string sent in User-Agent for all HTTP fetches (be a good citizen)
MILMAP_CONTACT=you@example.com

# ---- Web (Vite) ----
# Where the static data build lives (manifest.json + days/ + tiles/). Dev default serves data/build.
VITE_DATA_BASE_URL=/data
# Optional self-hosted Protomaps extract (pmtiles extract --bbox=21.5,43.5,41.5,53.5). If unset, a keyless dev basemap is used.
VITE_PMTILES_URL=
VITE_BASEMAP_FLAVOR=dark
